import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import make_classification
from sklearn.model_selection import train_test_split
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import (
    accuracy_score, precision_score, recall_score,
    f1_score, classification_report, ConfusionMatrixDisplay
)
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import (
    BaggingClassifier, RandomForestClassifier,
    AdaBoostClassifier, GradientBoostingClassifier
)
from sklearn.linear_model import LogisticRegression
from xgboost import XGBClassifier
from lightgbm import LGBMClassifier

# 1. CREATE DATASET
X, y = make_classification(
    n_samples=2000,
    n_features=20,
    n_informative=10,
    n_redundant=5,
    random_state=42
)

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

print("Training samples:", len(X_train))
print("Testing samples:", len(X_test))

# 2. DEFINE ENSEMBLE MODELS
models = {
    "Decision Tree": DecisionTreeClassifier(random_state=42),

    "Bagging": BaggingClassifier(
        estimator=DecisionTreeClassifier(),
        n_estimators=100,
        random_state=42,
        n_jobs=-1
    ),

    "Random Forest": RandomForestClassifier(
        n_estimators=150,
        random_state=42,
        n_jobs=-1
    ),

    "AdaBoost": AdaBoostClassifier(
        n_estimators=100,
        random_state=42
    ),

    "Gradient Boosting": GradientBoostingClassifier(
        n_estimators=100,
        learning_rate=0.05,
        max_depth=2,
        random_state=42
    ),

    "XGBoost": XGBClassifier(
        n_estimators=100,
        max_depth=4,
        learning_rate=0.05,
        eval_metric="logloss",
        reg_lambda=1.0,
        random_state=42,
        n_jobs=-1
    ),

    "LightGBM": LGBMClassifier(
        n_estimators=100,
        learning_rate=0.05,
        num_leaves=15,
        verbosity=-1,
        random_state=42,
        n_jobs=-1
    ),

    "Logistic Regression L1": make_pipeline(
        StandardScaler(),
        LogisticRegression(
            penalty="l1", solver="liblinear",
            C=0.5, max_iter=2000
        )
    ),

    "Logistic Regression L2": make_pipeline(
        StandardScaler(),
        LogisticRegression(
            penalty="l2", solver="lbfgs",
            C=0.5, max_iter=2000
        )
    )
}

# 3. TRAIN AND EVALUATE MODELS
results = []
trained_models = {}

for name, model in models.items():
    model.fit(X_train, y_train)
    trained_models[name] = model

    train_pred = model.predict(X_train)
    test_pred = model.predict(X_test)

    results.append({
        "Model": name,
        "Train Accuracy": accuracy_score(y_train, train_pred),
        "Test Accuracy": accuracy_score(y_test, test_pred),
        "Precision": precision_score(
            y_test, test_pred, zero_division=0
        ),
        "Recall": recall_score(
            y_test, test_pred, zero_division=0
        ),
        "F1 Score": f1_score(
            y_test, test_pred, zero_division=0
        )
    })

results_df = pd.DataFrame(results).sort_values(
    "Test Accuracy", ascending=False
).reset_index(drop=True)

print("\nMODEL COMPARISON")
print(results_df.round(4).to_string(index=False))

# 4. COMPARE TRAINING AND TESTING ACCURACY
plot_df = results_df.sort_values("Test Accuracy")
positions = np.arange(len(plot_df))
height = 0.35

plt.figure(figsize=(12, 7))
plt.barh(
    positions - height / 2,
    plot_df["Train Accuracy"],
    height=height, label="Training Accuracy"
)
plt.barh(
    positions + height / 2,
    plot_df["Test Accuracy"],
    height=height, label="Testing Accuracy"
)
plt.yticks(positions, plot_df["Model"])
plt.xlabel("Accuracy")
plt.title("Ensemble Models: Training vs Testing Accuracy")
plt.xlim(0, 1.05)
plt.legend()
plt.tight_layout()
plt.show()

# 5. BIAS-VARIANCE AND OVERFITTING/UNDERFITTING
depth_results = []

for depth in [1, 2, 3, 5, 8, 12, None]:
    tree = DecisionTreeClassifier(
        max_depth=depth, random_state=42
    )
    tree.fit(X_train, y_train)

    train_acc = accuracy_score(
        y_train, tree.predict(X_train)
    )
    test_acc = accuracy_score(
        y_test, tree.predict(X_test)
    )

    depth_results.append({
        "Tree Depth": str(depth),
        "Train Accuracy": train_acc,
        "Test Accuracy": test_acc,
        "Generalization Gap": train_acc - test_acc
    })

depth_df = pd.DataFrame(depth_results)
print("\nBIAS-VARIANCE EXPERIMENT")
print(depth_df.round(4).to_string(index=False))

plt.figure(figsize=(9, 5))
plt.plot(
    depth_df["Tree Depth"], depth_df["Train Accuracy"],
    marker="o", label="Training Accuracy"
)
plt.plot(
    depth_df["Tree Depth"], depth_df["Test Accuracy"],
    marker="o", label="Testing Accuracy"
)
plt.xlabel("Maximum Tree Depth")
plt.ylabel("Accuracy")
plt.title("Bias-Variance Tradeoff")
plt.ylim(0.5, 1.02)
plt.legend()
plt.tight_layout()
plt.show()

# 6. REGULARIZATION: L1 VS L2
regularization_results = []

for penalty, solver in [
    ("l1", "liblinear"),
    ("l2", "lbfgs")
]:
    for C in [0.01, 0.1, 1, 10, 100]:
        model = make_pipeline(
            StandardScaler(),
            LogisticRegression(
                penalty=penalty,
                solver=solver,
                C=C,
                max_iter=3000
            )
        )

        model.fit(X_train, y_train)

        train_acc = accuracy_score(
            y_train, model.predict(X_train)
        )
        test_acc = accuracy_score(
            y_test, model.predict(X_test)
        )

        lr = model.named_steps["logisticregression"]

        regularization_results.append({
            "Penalty": penalty.upper(),
            "C": C,
            "Train Accuracy": train_acc,
            "Test Accuracy": test_acc,
            "Nonzero Coefficients": int(
                np.sum(np.abs(lr.coef_) > 1e-8)
            )
        })

reg_df = pd.DataFrame(regularization_results)

print("\nL1 AND L2 REGULARIZATION RESULTS")
print(reg_df.round(4).to_string(index=False))

for penalty in ["L1", "L2"]:
    subset = reg_df[reg_df["Penalty"] == penalty]
    plt.plot(
        subset["C"], subset["Test Accuracy"],
        marker="o", label=penalty
    )

plt.xscale("log")
plt.xlabel("C (smaller C = stronger regularization)")
plt.ylabel("Test Accuracy")
plt.title("Effect of L1 and L2 Regularization")
plt.legend()
plt.tight_layout()
plt.show()

# 7. CONFUSION MATRIX FOR THE BEST TEST-ACCURACY MODEL
best_name = results_df.iloc[0]["Model"]
best_model = trained_models[best_name]
predictions = best_model.predict(X_test)

print("\nBest model by test accuracy:", best_name)
print("\nCLASSIFICATION REPORT")
print(classification_report(
    y_test, predictions, zero_division=0
))

ConfusionMatrixDisplay.from_predictions(
    y_test, predictions, values_format="d"
)
plt.title("Confusion Matrix: " + best_name)
plt.tight_layout()
plt.show()

