print("\n" + "=" * 60)
print("PART 2: PERCEPTRON AND ACTIVATION FUNCTIONS")
print("=" * 60)

def step_activation(z):
    return np.where(z >= 0, 1, 0)

def sigmoid(z):
    z = np.clip(z, -500, 500)
    return 1 / (1 + np.exp(-z))

def tanh_activation(z):
    return np.tanh(z)

def relu(z):
    return np.maximum(0, z)

def leaky_relu(z):
    return np.where(z > 0, z, 0.01 * z)

def softmax(z):
    shifted = z - np.max(z, axis=-1, keepdims=True)
    exp_values = np.exp(shifted)
    return exp_values / np.sum(exp_values, axis=-1, keepdims=True)

# Perceptron formula: output = activation(X.W + b)
inputs = np.array([1.0, 2.0, 3.0])
weights = np.array([0.2, 0.4, 0.1])
bias = -0.5

z = np.dot(inputs, weights) + bias

print("Inputs:", inputs)
print("Weights:", weights)
print("Bias:", bias)
print("Weighted sum:", z)
print("Step activation:", step_activation(z))
print("Sigmoid:", sigmoid(z))
print("Tanh:", tanh_activation(z))
print("ReLU:", relu(z))
print("Leaky ReLU:", leaky_relu(z))
print("Softmax:", softmax(np.array([1.0, 2.0, 3.0])))

# Plot activation functions
