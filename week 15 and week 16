# PART 4: STOCHASTIC GRADIENT DESCENT (SGD) AND ADAM
# ==============================================================

print("\n" + "=" * 60)
print("PART 4: OPTIMIZERS - SGD AND ADAM")
print("=" * 60)

# Minimize f(w) = (w - 3)^2
# Gradient = 2 * (w - 3)

def optimize_sgd(initial_w, learning_rate=0.1, steps=50):
    w = initial_w
    history = []

    for _ in range(steps):
        gradient = 2 * (w - 3)
        w = w - learning_rate * gradient
        history.append((w - 3) ** 2)

    return w, history

def optimize_adam(initial_w, learning_rate=0.1, steps=50):
    w = initial_w
    m = 0.0
    v = 0.0
    beta1 = 0.9
    beta2 = 0.999
    epsilon = 1e-8
    history = []

    for t in range(1, steps + 1):
        gradient = 2 * (w - 3)

        m = beta1 * m + (1 - beta1) * gradient
        v = beta2 * v + (1 - beta2) * gradient**2

        m_hat = m / (1 - beta1**t)
        v_hat = v / (1 - beta2**t)

        w = w - learning_rate * m_hat / (np.sqrt(v_hat) + epsilon)
        history.append((w - 3) ** 2)

    return w, history

sgd_final, sgd_history = optimize_sgd(0.0)
adam_final, adam_history = optimize_adam(0.0)

print("SGD final parameter:", round(sgd_final, 6))
print("Adam final parameter:", round(adam_final, 6))
print("Target parameter: 3.0")

plt.figure(figsize=(9, 5))
plt.plot(sgd_history, label="SGD")
plt.plot(adam_history, label="Adam")
plt.xlabel("Optimization step")
plt.ylabel("Squared error")
plt.title("SGD vs Adam")
plt.legend()
plt.grid(True)
plt.show()


# ==============================================================
# PART 5: NEURAL NETWORK FROM SCRATCH USING NUMPY
# Binary classification with one hidden layer
# Architecture: 2 inputs -> 16 hidden neurons -> 1 output
# ==============================================================

print("\n" + "=" * 60)
print("PART 5: NEURAL NETWORK FROM SCRATCH")
print("=" * 60)

# Standardize the input data
scaler = StandardScaler()
X_train_nn = scaler.fit_transform(X_train)
X_test_nn = scaler.transform(X_test)

# Convert data into column vectors
X_train_nn = X_train_nn.T
X_test_nn = X_test_nn.T
Y_train_nn = y_train.reshape(1, -1)
Y_test_nn = y_test.reshape(1, -1)

n_inputs = X_train_nn.shape[0]
n_hidden = 16
n_outputs = 1

# Initialize weights and biases
W1 = np.random.randn(n_hidden, n_inputs) * np.sqrt(2 / n_inputs)
b1 = np.zeros((n_hidden, 1))

W2 = np.random.randn(n_outputs, n_hidden) * np.sqrt(2 / n_hidden)
b2 = np.zeros((n_outputs, 1))

# Training settings
learning_rate = 0.01
epochs = 3000
m = X_train_nn.shape[1]

loss_history = []
accuracy_history = []

# Adam optimizer state
beta1 = 0.9
beta2 = 0.999
epsilon = 1e-8

parameters = {"W1": W1, "b1": b1, "W2": W2, "b2": b2}
first_moment = {k: np.zeros_like(v) for k, v in parameters.items()}
second_moment = {k: np.zeros_like(v) for k, v in parameters.items()}

# Forward propagation, loss, backward propagation, and Adam updates
for epoch in range(1, epochs + 1):

    # FORWARD PROPAGATION
    Z1 = W1 @ X_train_nn + b1
    A1 = np.maximum(0, Z1)          # ReLU hidden layer

    Z2 = W2 @ A1 + b2
    A2 = sigmoid(Z2)                # Sigmoid output layer

    # Binary cross-entropy loss
    loss = -np.mean(
        Y_train_nn * np.log(A2 + epsilon) +
        (1 - Y_train_nn) * np.log(1 - A2 + epsilon)
    )

    # BACKWARD PROPAGATION
    dZ2 = A2 - Y_train_nn
    dW2 = (dZ2 @ A1.T) / m
    db2 = np.sum(dZ2, axis=1, keepdims=True) / m

    dA1 = W2.T @ dZ2
    dZ1 = dA1 * (Z1 > 0)
    dW1 = (dZ1 @ X_train_nn.T) / m
    db1 = np.sum(dZ1, axis=1, keepdims=True) / m

    gradients = {"W1": dW1, "b1": db1, "W2": dW2, "b2": db2}

    # ADAM OPTIMIZER
    for key in parameters:
        first_moment[key] = (
            beta1 * first_moment[key] +
            (1 - beta1) * gradients[key]
        )
        second_moment[key] = (
            beta2 * second_moment[key] +
            (1 - beta2) * gradients[key]**2
        )

        m_hat = first_moment[key] / (1 - beta1**epoch)
        v_hat = second_moment[key] / (1 - beta2**epoch)

        parameters[key] -= (
            learning_rate * m_hat /
            (np.sqrt(v_hat) + epsilon)
        )

    # Record loss and accuracy
    if epoch % 100 == 0:
        loss_history.append(loss)
        train_predictions = (A2 >= 0.5).astype(int)
        train_accuracy = np.mean(train_predictions == Y_train_nn)
        accuracy_history.append(train_accuracy)

        if epoch % 500 == 0:
            print(
                f"Epoch {epoch:4d} | "
                f"Loss: {loss:.4f} | "
                f"Training accuracy: {train_accuracy:.4f}"
            )

# Evaluate trained neural network
Z1_test = W1 @ X_test_nn + b1
A1_test = np.maximum(0, Z1_test)
Z2_test = W2 @ A1_test + b2
A2_test = sigmoid(Z2_test)

nn_predictions = (A2_test >= 0.5).astype(int).flatten()

print("\nNeural Network Test Accuracy:",
      accuracy_score(y_test, nn_predictions))
print("\nNeural Network Classification Report:")
print(classification_report(y_test, nn_predictions, zero_division=0))

# Plot training loss
plt.figure(figsize=(9, 5))
plt.plot(np.arange(100, epochs + 1, 100), loss_history)
plt.xlabel("Epoch")
plt.ylabel("Binary Cross-Entropy Loss")
plt.title("Neural Network Training Loss")
plt.grid(True)
plt.show()

