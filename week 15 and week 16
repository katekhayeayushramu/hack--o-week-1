# ==============================================================
# PART 1: MODEL DEPLOYMENT - PICKLE AND JOBLIB
# ==============================================================

print("=" * 60)
print("PART 1: MODEL DEPLOYMENT")
print("=" * 60)

# Create a sample classification dataset
X, y = make_moons(n_samples=1000, noise=0.20, random_state=42)

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)

# Train a standard ML model
deployment_model = LogisticRegression(max_iter=1000)
deployment_model.fit(X_train, y_train)

original_predictions = deployment_model.predict(X_test)
print("Original model accuracy:",
      accuracy_score(y_test, original_predictions))

# Save model using Pickle
with open("model.pkl", "wb") as file:
    pickle.dump(deployment_model, file)

# Load model using Pickle
with open("model.pkl", "rb") as file:
    loaded_pickle_model = pickle.load(file)

pickle_predictions = loaded_pickle_model.predict(X_test)
print("Pickle model accuracy:",
      accuracy_score(y_test, pickle_predictions))

# Save model using Joblib
joblib.dump(deployment_model, "model.joblib")

# Load model using Joblib
loaded_joblib_model = joblib.load("model.joblib")

joblib_predictions = loaded_joblib_model.predict(X_test)
print("Joblib model accuracy:",
      accuracy_score(y_test, joblib_predictions))

# Demonstrate inference on a new sample
new_sample = np.array([[0.5, 0.2]])
print("Prediction for new sample:",
      loaded_joblib_model.predict(new_sample)[0])

print("Saved files:", os.path.exists("model.pkl"),
      os.path.exists("model.joblib"))

