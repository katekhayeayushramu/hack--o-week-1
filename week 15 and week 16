# Save weights, biases, and input scaler together
nn_model = {
    "W1": W1,
    "b1": b1,
    "W2": W2,
    "b2": b2,
    "scaler_mean": scaler.mean_,
    "scaler_scale": scaler.scale_
}

joblib.dump(nn_model, "numpy_neural_network.joblib")
print("Neural network saved as numpy_neural_network.joblib")

# Reload the neural network
loaded_nn = joblib.load("numpy_neural_network.joblib")

# Predict one new sample using the saved parameters
sample = np.array([[0.5, 0.2]])
sample_scaled = (
    sample - loaded_nn["scaler_mean"]
) / loaded_nn["scaler_scale"]

sample_scaled = sample_scaled.T
hidden = np.maximum(
    0, loaded_nn["W1"] @ sample_scaled + loaded_nn["b1"]
)
output = sigmoid(
    loaded_nn["W2"] @ hidden + loaded_nn["b2"]
)

print("Saved neural network probability:", float(output[0, 0]))
print("Saved neural network class:", int(output[0, 0] >= 0.5))

